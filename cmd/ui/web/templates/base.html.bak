{{define "base"}}
<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}PGW{{end}} — Proxy Gateway Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/styles.css?v=1771588800">
</head>

<body>
  <div class="layout-wrapper">
    <!-- Sidebar -->
    <aside class="layout-menu" id="layout-menu">
      <!-- Brand -->
      <div class="app-brand">
        <a href="/" class="app-brand-link">
          <span class="app-brand-logo">
            <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
          </span>
          <span class="app-brand-text fw-semibold ms-2">PGW</span>
        </a>
        <button class="layout-menu-toggle btn btn-sm p-0 ms-auto d-xl-none" id="menu-toggle-close">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="menu-divider"></div>

      <ul class="menu-inner">
        <li class="menu-header">MAIN</li>

        <li class="menu-item{{if eq .ActivePage " dashboard"}} active{{end}}">
          <a href="/" class="menu-link">
            <i class="menu-icon bi bi-speedometer2"></i>
            <span>Dashboard</span>
          </a>
        </li>

        <li class="menu-item{{if eq .ActivePage " proxies"}} active{{end}}">
          <a href="/proxies" class="menu-link">
            <i class="menu-icon bi bi-hdd-network"></i>
            <span>Proxy Servers</span>
          </a>
        </li>

        <li class="menu-item{{if eq .ActivePage " manage"}} active{{end}}">
          <a href="/manage" class="menu-link">
            <i class="menu-icon bi bi-diagram-3"></i>
            <span>Mappings</span>
          </a>
        </li>

        <li class="menu-divider mt-3"></li>
        <li class="menu-header">ACCOUNT MANAGEMENT</li>

        <li class="menu-item{{if eq .ActivePage " emails"}} active{{end}}">
          <a href="/emails" class="menu-link">
            <i class="menu-icon bi bi-envelope"></i>
            <span>Emails</span>
          </a>
        </li>

        <li class="menu-item{{if eq .ActivePage " paypal"}} active{{end}}">
          <a href="/paypal" class="menu-link">
            <i class="menu-icon bi bi-paypal"></i>
            <span>PayPal</span>
          </a>
        </li>

        <li class="menu-item{{if eq .ActivePage " income"}} active{{end}}">
          <a href="/income" class="menu-link">
            <i class="menu-icon bi bi-cash-stack"></i>
            <span>Income</span>
          </a>
        </li>

        <li class="menu-item{{if eq .ActivePage " reports"}} active{{end}}">
          <a href="/reports" class="menu-link">
            <i class="menu-icon bi bi-bar-chart-line"></i>
            <span>Reports</span>
          </a>
        </li>

        <li class="menu-divider mt-3"></li>
        <li class="menu-header">SYSTEM</li>

        <li class="menu-item">
          <a href="/logout" class="menu-link text-danger">
            <i class="menu-icon bi bi-box-arrow-left"></i>
            <span>Đăng xuất</span>
          </a>
        </li>
      </ul>
    </aside>

    <!-- /Sidebar -->

    <!-- Layout page -->
    <div class="layout-page">
      <!-- Navbar -->
      <nav class="layout-navbar">
        <button class="btn btn-sm btn-icon d-xl-none me-3" id="menu-toggle-open">
          <i class="bi bi-list fs-5"></i>
        </button>

        <div class="ms-auto d-flex align-items-center gap-3">
          <div id="navbar-clock" class="text-muted small"></div>
          <div class="vr opacity-25"></div>
          <div class="d-flex align-items-center gap-2">
            <div
              class="avatar avatar-sm bg-primary-light rounded-circle d-flex align-items-center justify-content-center"
              style="width:34px;height:34px;">
              <i class="bi bi-person-fill text-primary"></i>
            </div>
            <span class="fw-medium small d-none d-md-inline">Admin</span>
          </div>
          <a href="/logout" class="btn btn-sm btn-outline-danger d-none d-md-inline-flex align-items-center gap-1">
            <i class="bi bi-box-arrow-left"></i>
          </a>
        </div>
      </nav>
      <!-- /Navbar -->

      <!-- Content wrapper -->
      <div class="content-wrapper">
        <div id="toast-container"></div>
        {{block "content" .}}{{end}}
      </div>
      <!-- /Content wrapper -->

      <!-- Footer -->
      <footer class="content-footer">
        <span class="text-muted small">PGW — Proxy Gateway Manager</span>
      </footer>
    </div>
    <!-- /Layout page -->
  </div>

  <!-- Sidebar overlay (mobile) -->
  <div class="layout-overlay" id="layout-overlay"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/static/app.js?v=1771588800"></script>
  <script>
    // Clock
    function updateClock() {
      const el = document.getElementById('navbar-clock');
      if (el) el.textContent = new Date().toLocaleTimeString('vi-VN');
    }
    updateClock(); setInterval(updateClock, 1000);

    // Mobile menu toggle
    const menu = document.getElementById('layout-menu');
    const overlay = document.getElementById('layout-overlay');
    document.getElementById('menu-toggle-open')?.addEventListener('click', () => {
      menu.classList.add('show'); overlay.classList.add('show');
    });
    document.getElementById('menu-toggle-close')?.addEventListener('click', () => {
      menu.classList.remove('show'); overlay.classList.remove('show');
    });
    overlay?.addEventListener('click', () => {
      menu.classList.remove('show'); overlay.classList.remove('show');
    });
  </script>
  {{block "scripts" .}}{{end}}
</body>

</html>
{{end}}