
# Proxy Gateway Manager — Environment Template
# Copy to /etc/pgw/pgw.env and fill in your values.

## ── API ──────────────────────────────────
PGW_API_ADDR=:8080

# Storage backend: memory | file | sqlite (recommended for production)
PGW_STORE=sqlite
PGW_STORE_PATH=/var/lib/pgw/state.db

# Health check interval
PGW_HEALTH_INTERVAL=30s

# JWT (required)
PGW_JWT_SECRET=change-me-to-32-char-minimum-secret

# Admin credentials (use PASS_HASH for production)
PGW_ADMIN_USER=admin
PGW_ADMIN_PASS_HASH=         # Argon2id PHC — run: pgw-api --hash-password
# PGW_ADMIN_PASS=plain-text  # Not recommended

# Agent token (shared between API, Agent, Forwarder)
PGW_AGENT_TOKEN=change-me-agent-token

# Mapping port range for forwarder
PGW_FWD_BASE_PORT=15001
PGW_FWD_MAX_PORT=15999

## ── Agent ────────────────────────────────
PGW_AGENT_ADDR=:9090
PGW_API_BASE=http://127.0.0.1:8080
PGW_WAN_IFACE=eth0
PGW_LAN_IFACE=ens19
PGW_AGENT_RECONCILE=15s

## ── Forwarder ────────────────────────────
PGW_FWD_ADDR=192.168.2.1:15001
PGW_FWD_DIAL_TIMEOUT=5s
PGW_FWD_POLL_INTERVAL=30s
PGW_FWD_MAX_CONNS=8192
PGW_FWD_LOG_SAMPLE=100
PGW_FWD_IDLE_TIMEOUT=30m

## ── UI ───────────────────────────────────
PGW_UI_ADDR=:8081
PGW_UI_API=http://127.0.0.1:8080
PGW_UI_AGENT=http://127.0.0.1:9090/agent
